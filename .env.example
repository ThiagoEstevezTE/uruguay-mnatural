# Copiar como .env y completar. Los datos de la base solo hacen falta si NO usás la de Docker (docker-compose.yml).
# Supabase: Project Settings > Database > Connection string > JDBC (Session pooler)
DB_URL=jdbc:postgresql://localhost:5432/uymnatural
DB_USER=postgres
DB_PASSWORD=postgres

# update (por defecto): no se borra nada al arrancar. Usar este con Supabase.
# create: borra y vuelve a cargar los datos de ejemplo en cada arranque (demo local).
#   Con Supabase, solo una vez la mañana de la demo, y después volver a update (ver docs/GUION_DEMO.md).
DB_DDL_AUTO=update
# Contraseña de las cuentas de ejemplo. Si no se pone, es demo1234 (la de los manuales).
# Si la base o la app quedan accesibles para otros, sacale el # y poné otra antes del primer arranque.
# DEMO_PASSWORD=

# Mercado Pago (cuenta de prueba). Las claves se pasan por privado: nunca se suben a GitHub.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
# Sin claves de Mercado Pago, sacale el # para usar el pago simulado de la app.
# PAYMENT_PROVIDER=simulator
